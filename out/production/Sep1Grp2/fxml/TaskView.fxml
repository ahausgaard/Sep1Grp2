<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kløverly.presentation.controllers.TaskViewController">
    <children>
        <Label fx:id="taskHeaderLabel" contentDisplay="CENTER" text="Opgave:" textAlignment="CENTER">
            <font>
                <Font size="20.0" />
            </font>
        </Label>
        <GridPane alignment="TOP_CENTER" hgap="20.0" minHeight="200.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <VBox prefHeight="200.0" prefWidth="100.0">
                    <children>
                        <Label text="Id">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <Label fx:id="displayId" text="0" />
                    </children>
                </VBox>
                <VBox prefHeight="200.0" prefWidth="100.0" GridPane.rowIndex="1">
                    <children>
                        <Label text="Pointværdi">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <StackPane alignment="TOP_LEFT" prefHeight="150.0" prefWidth="200.0">
                            <children>
                                <Label fx:id="displayValue" text="0" />
                                <Spinner fx:id="editValue" visible="false" />
                            </children>
                        </StackPane>
                    </children>
                </VBox>
                <VBox prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
                    <children>
                        <Label text="Beskrivelse">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <StackPane alignment="TOP_LEFT" prefHeight="150.0" prefWidth="200.0">
                            <children>
                                <Label fx:id="displayDescription" />
                                <TextField fx:id="editDescription" />
                            </children>
                        </StackPane>
                    </children>
                </VBox>
                <VBox prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                  <Label fx:id="stakeholderLabel" text="Opgaveejer" visible="false">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                        <StackPane alignment="TOP_LEFT" prefHeight="150.0" prefWidth="200.0">
                            <children>
                                <Label fx:id="displayStakeholder" />
                                <TextField fx:id="editStakeholder" visible="false" />
                            </children>
                        </StackPane>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </GridPane>
        <Region prefHeight="150.0" prefWidth="200.0" />
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
            <children>
                <ComboBox fx:id="completerBox" prefWidth="150.0" promptText="Vælg beboer" />
                <Button fx:id="finishTaskButton" mnemonicParsing="false" onAction="#onFinishTaskButtonPressed" styleClass="button-primary" text="Udfør" />
            <Button fx:id="deleteTaskButton" mnemonicParsing="false" onAction="#onDeleteTaskButtonPressed" prefHeight="25.0" prefWidth="98.0" styleClass="button-accent" text="Slet opgave" />
                <Button fx:id="editTaskButton" mnemonicParsing="false" onAction="#onEditTaskButtonPressed" styleClass="button-primary" text="Redigér" />
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onCancelButtonPressed" prefHeight="25.0" prefWidth="84.0" styleClass="button-secondary" text="Tilbage" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
