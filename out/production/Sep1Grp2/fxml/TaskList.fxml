<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kløverly.presentation.controllers.TaskListController">

    <children>

        <!-- SIDE-TITEL -->
        <Label styleClass="view-title" text="Tilgængelige opgaver">
            <VBox.margin>
                <Insets bottom="20.0" top="40.0" />
            </VBox.margin>
        </Label>

        <!-- TABEL MED OPGAVER -->
        <TableView fx:id="taskTable" prefHeight="332.0" prefWidth="600.0" styleClass="task-table">
            <columns>
                <TableColumn fx:id="taskNameColumn" prefWidth="260.0" text="Titel" />
                <TableColumn fx:id="taskTypeColumn" prefWidth="235.0" text="Opgavetype" />
                <TableColumn fx:id="taskValueColumn" prefWidth="96.0" text="Pointværdi" />
            </columns>
        </TableView>

        <!-- KNAPPER NEDERST -->
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
            <children>
                <Button fx:id="openTaskButton" mnemonicParsing="false" onAction="#onOpenTaskButtonPressed" styleClass="form-button-primary" text="Åbn opgave">
                    <HBox.margin>
                        <Insets top="20.0" />
                    </HBox.margin>
                </Button>

                <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />

                <Button fx:id="backButton" mnemonicParsing="false" onAction="#onBackButtonPressed" styleClass="form-button-secondary" text="Tilbage">
                    <HBox.margin>
                        <Insets top="20.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>

    </children>
</VBox>
