<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kløverly.presentation.controllers.ResidentListController">

    <children>

        <!-- SIDE-TITEL -->
        <Label styleClass="view-title" text="Beboere i Kløverly">
            <VBox.margin>
                <Insets bottom="20.0" top="40.0" />
            </VBox.margin>
        </Label>

        <!-- TABEL MED BEBOERE -->
        <TableView fx:id="residentTable" prefHeight="332.0" prefWidth="600.0" styleClass="task-table">
            <columns>
                <TableColumn fx:id="residentNameColumn" prefWidth="260.0" text="Navn" />
                <TableColumn fx:id="residentIdColumn" prefWidth="232.0" text="Id" />
                <TableColumn fx:id="residentPointsColumn" prefWidth="99.0" text="Antal point" />
            </columns>
        </TableView>

        <!-- KNAPPER NEDERST -->
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
            <children>
                <Button fx:id="openResidentViewButton" mnemonicParsing="false" onAction="#onOpenResidentViewPressed" styleClass="form-button-primary" text="Åbn beboerside">
                    <HBox.margin>
                        <Insets top="20.0" />
                    </HBox.margin>
                </Button>

                <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />

                <Button fx:id="backButton" mnemonicParsing="false" onAction="#onBackButtonPressed" styleClass="form-button-secondary" text="Tilbage">
                    <HBox.margin>
                        <Insets top="20.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>

    </children>
</VBox>
