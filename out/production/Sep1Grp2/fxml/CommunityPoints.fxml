<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kløverly.presentation.controllers.CommunityPointsController">
    <children>
        <Label text="Fællespoint Status">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <Label fx:id="pointsLabel" text="Henter point..." textFill="#2e7d32">
            <font>
                <Font size="18.0" />
            </font>
        </Label>

        <ProgressBar fx:id="progressBar" prefWidth="400.0" progress="0.0" style="-fx-accent: #4caf50;" />

        <Button mnemonicParsing="false" onAction="#onBackButtonPressed" text="Tilbage til oversigt" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>