<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" styleClass="form-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kløverly.presentation.controllers.AddTaskController">

    <children>
        <!-- Selve kortet i midten -->
        <VBox spacing="18" styleClass="form-card">

            <!-- Titel -->
            <Label styleClass="form-title" text="Registrér opgave" />

            <!-- Opgavetype / beboer -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <children>
                    <ComboBox fx:id="taskChoiceBox" promptText="Vælg opgavetype" styleClass="form-input-spinner" />
                    <ComboBox fx:id="swapTargetBox" managed="false" promptText="Vælg beboer" styleClass="form-input-spinner" visible="false" />
                </children>
            </HBox>

            <!-- Opgavetitel -->
            <VBox spacing="5">
                <children>
                    <Label styleClass="form-label" text="Opgavetitel" />
                    <TextField fx:id="taskNameInput" styleClass="form-input" />
                </children>
            </VBox>

            <!-- Opgavebeskrivelse -->
            <VBox spacing="5">
                <children>
                    <Label styleClass="form-label" text="Opgavebeskrivelse" />
                    <TextField fx:id="taskDescriptionInput" styleClass="form-input" />
                </children>
            </VBox>

            <!-- Point -->
            <VBox spacing="5">
                <children>
                    <Label styleClass="form-label" text="Point" />
                    <Spinner fx:id="spinner" editable="true" styleClass="form-input-spinner" />
                </children>
            </VBox>

            <!-- Knapper -->
            <HBox alignment="CENTER" spacing="20">
                <children>
                    <Button fx:id="addTaskButton" mnemonicParsing="false" onAction="#onAddTaskButtonPressed" styleClass="form-button-primary" text="Tilføj" />

                    <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onCancelButtonPressed" styleClass="form-button-secondary" text="Annullér" />
                </children>
            </HBox>

            <!-- Status-tekst -->
            <Label fx:id="statusLabel" styleClass="form-status" text="" />

        </VBox>
    </children>

</VBox>
