<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kløverly.presentation.controllers.GreenPointsViewController">
    <children>
        <Label text="Grønne point">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <Label fx:id="goalTitleLabel" text="Mål: Ingen" textFill="#2e7d32">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <Label fx:id="deadlineLabel" text="Deadline: ...">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <Label fx:id="GreenPointsDescriptionLabel" text="Præmie..." wrapText="true">
            <font>
                <Font name="System Italic" size="16.0" />
            </font>
        </Label>

        <ProgressBar fx:id="progressBar" prefWidth="400.0" progress="0.0" style="-fx-accent: #4caf50;" />

        <Label fx:id="pointsLabel" text="0 / 1000 point" />

        <Button mnemonicParsing="false" onAction="#onBackButtonPressed" styleClass="button-primary" text="Tilbage til oversigt" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
