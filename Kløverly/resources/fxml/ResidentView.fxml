<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kløverly.presentation.controllers.ResidentViewController">

    <children>

        <!-- OVERSKRIFT -->
        <Label fx:id="residentHeaderLabel" contentDisplay="CENTER" styleClass="view-title" text="Beboer:" textAlignment="CENTER">
            <VBox.margin>
                <Insets bottom="30.0" top="40.0" />
            </VBox.margin>
        </Label>

        <!-- KORT MED BEBOER-DETALJER -->
        <GridPane alignment="CENTER" hgap="40.0" styleClass="detail-card" vgap="25.0">

            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="180.0" />
            </columnConstraints>

            <rowConstraints>
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>

            <children>

                <!-- ID -->
                <VBox>
                    <children>
                        <Label styleClass="detail-label" text="Id" />
                        <Label fx:id="displayId" styleClass="detail-value" text="0" />
                    </children>
                </VBox>

                <!-- AKTIVITETSNIVEAU -->
                <VBox GridPane.rowIndex="1">
                    <children>
                        <Label styleClass="detail-label" text="Aktivitetsniveau" />
                        <StackPane alignment="TOP_LEFT" prefHeight="30.0">
                            <children>
                                <Label fx:id="displayActivityLevel" styleClass="detail-value" text="0" />
                                <Spinner fx:id="editActivityLevel" visible="false" />
                            </children>
                        </StackPane>
                    </children>
                </VBox>

                <!-- PERSONLIGE POINT -->
                <VBox GridPane.columnIndex="1">
                    <children>
                        <Label styleClass="detail-label" text="Personlige point" />
                        <StackPane alignment="TOP_LEFT" prefHeight="30.0">
                            <children>
                                <Label fx:id="displayPersonalPoints" styleClass="detail-value" text="0" />
                                <Spinner fx:id="editPersonalPoints" visible="false" />
                            </children>
                        </StackPane>
                    </children>
                </VBox>

            </children>
        </GridPane>

        <Region prefHeight="40.0" prefWidth="200.0" />

        <!-- KNAPPER NEDERST -->
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Region prefHeight="40.0" prefWidth="220.0" HBox.hgrow="ALWAYS" />

                <Button fx:id="deleteResidentButton" mnemonicParsing="false" onAction="#onDeleteResidentButtonPressed" styleClass="form-button-accent" text="Slet" />

                <Button fx:id="editTaskButton" mnemonicParsing="false" onAction="#onEditTaskButtonPressed" styleClass="form-button-primary" text="Redigér" />

                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onCancelButtonPressed" styleClass="form-button-secondary" text="Tilbage" />
            </children>
        </HBox>

    </children>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
