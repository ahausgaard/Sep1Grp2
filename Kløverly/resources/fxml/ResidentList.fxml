<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kløverly.presentation.controllers.ResidentListController"
      alignment="TOP_CENTER"
      prefHeight="400.0" prefWidth="600.0"
      maxHeight="-Infinity" maxWidth="-Infinity"
      minHeight="-Infinity" minWidth="-Infinity">

    <children>

        <!-- SIDE-TITEL -->
        <Label text="Beboere i Kløverly" styleClass="view-title">
            <VBox.margin>
                <Insets top="40.0" bottom="20.0" />
            </VBox.margin>
        </Label>

        <!-- TABEL MED BEBOERE -->
        <TableView fx:id="residentTable"
                   prefHeight="332.0" prefWidth="600.0"
                   styleClass="task-table">
            <columns>
                <TableColumn fx:id="residentNameColumn"
                             prefWidth="260.0"
                             text="Navn" />
                <TableColumn fx:id="residentIdColumn"
                             prefWidth="232.0"
                             text="Id" />
                <TableColumn fx:id="residentPointsColumn"
                             prefWidth="99.0"
                             text="Antal point" />
            </columns>
        </TableView>

        <!-- KNAPPER NEDERST -->
        <HBox alignment="CENTER"
              prefHeight="100.0" prefWidth="200.0"
              spacing="10.0">
            <children>
                <Button fx:id="openResidentViewButton"
                        mnemonicParsing="false"
                        onAction="#onOpenResidentViewPressed"
                        styleClass="button-primary"
                        text="Åbn beboerside">
                    <HBox.margin>
                        <Insets top="20.0" />
                    </HBox.margin>
                </Button>

                <Region HBox.hgrow="ALWAYS"
                        prefHeight="200.0" prefWidth="200.0" />

                <Button fx:id="backButton"
                        mnemonicParsing="false"
                        onAction="#onBackButtonPressed"
                        styleClass="button-secondary"
                        text="Tilbage">
                    <HBox.margin>
                        <Insets top="20.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>

    </children>
</VBox>
