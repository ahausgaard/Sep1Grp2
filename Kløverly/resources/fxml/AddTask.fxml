<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kløverly.presentation.controllers.AddTaskController"
      alignment="CENTER"
      styleClass="form-root">

    <children>
        <!-- Selve kortet i midten -->
        <VBox spacing="18" styleClass="form-card">

            <!-- Titel -->
            <Label text="Registrér opgave" styleClass="form-title"/>

            <!-- Opgavetype / beboer -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <children>
                    <ComboBox fx:id="taskChoiceBox"
                              promptText="Vælg opgavetype"
                              styleClass="form-input"/>
                    <ComboBox fx:id="swapTargetBox"
                              promptText="Vælg beboer"
                              visible="false"
                              managed="false"
                              styleClass="form-input"/>
                </children>
            </HBox>

            <!-- Opgavetitel -->
            <VBox spacing="5">
                <children>
                    <Label text="Opgavetitel" styleClass="form-label"/>
                    <TextField fx:id="taskNameInput" styleClass="form-input"/>
                </children>
            </VBox>

            <!-- Opgavebeskrivelse -->
            <VBox spacing="5">
                <children>
                    <Label text="Opgavebeskrivelse" styleClass="form-label"/>
                    <TextField fx:id="taskDescriptionInput" styleClass="form-input"/>
                </children>
            </VBox>

            <!-- Point -->
            <VBox spacing="5">
                <children>
                    <Label text="Point" styleClass="form-label"/>
                    <Spinner fx:id="spinner"
                             editable="true"
                             styleClass="form-input-spinner"/>
                </children>
            </VBox>

            <!-- Knapper -->
            <HBox alignment="CENTER" spacing="20">
                <children>
                    <Button fx:id="addTaskButton"
                            text="Tilføj"
                            onAction="#onAddTaskButtonPressed"
                            mnemonicParsing="false"
                            styleClass="form-button-primary"/>

                    <Button fx:id="cancelButton"
                            text="Annullér"
                            onAction="#onCancelButtonPressed"
                            mnemonicParsing="false"
                            styleClass="form-button-secondary"/>
                </children>
            </HBox>

            <!-- Status-tekst -->
            <Label fx:id="statusLabel"
                   text=""
                   styleClass="form-status"/>

        </VBox>
    </children>

</VBox>
