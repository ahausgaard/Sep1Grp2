<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="490.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kløverly.presentation.controllers.AddTaskController">
   <children>
      <Label text="Registrér opgave" translateX="160.0">
         <font>
            <Font size="20.0" />
         </font>
         <VBox.margin>
            <Insets bottom="40.0" />
         </VBox.margin>
      </Label>
      <ComboBox fx:id="choiceBoxDrop" prefWidth="150.0" promptText="Vælge opgaves type" styleClass="required-combo" />
      <Label text="Opgavens navn" />
      <TextField fx:id="taskNameInput">
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </TextField>
      <Label text="Opgavebeskrivelse" />
      <TextField fx:id="taskDescriptionInput">
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </TextField>
      <Label fx:id="spinnerInput" text="Point" />
      <Spinner fx:id="spinner" editable="true" />
      <HBox alignment="CENTER" prefHeight="59.0" prefWidth="490.0" spacing="80.0">
         <children>
            <Button fx:id="addTaskButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#onAddTaskButtonPressed" styleClass="button-primary" text="Tilføj" />
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onCancelButtonPressed" styleClass="button-secondary" text="Annullér" />
         </children>
      </HBox>
      <Label fx:id="statusLabel" text="Status:" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
