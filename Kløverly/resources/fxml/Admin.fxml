<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kløverly.presentation.controllers.AdminController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <children>

        <!-- SIDE-TITEL -->
        <Label styleClass="view-title" text="Administratorside">
            <VBox.margin>
                <Insets bottom="30.0" />
            </VBox.margin>
        </Label>

        <!-- TO KORT SIDE OM SIDE -->
        <HBox alignment="TOP_CENTER" spacing="40.0">
            <children>

                <!-- BEBOER-KORT -->
                <VBox prefWidth="280.0" spacing="10.0" styleClass="detail-card">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label styleClass="detail-label" text="Beboer" />

                        <TextField fx:id="residentNameField" maxWidth="230.0" promptText="Beboers fulde navn" />

                        <Region prefHeight="10.0" />

                        <Button fx:id="addResidentButton" mnemonicParsing="false" onAction="#onAddResidentButtonPressed" styleClass="form-button-primary" text="Tilføj beboer" />
                    </children>
                </VBox>

                <!-- GRØNT MÅL-KORT -->
                <VBox prefWidth="320.0" spacing="10.0" styleClass="detail-card">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>

                        <Label styleClass="detail-label" text="Grønt mål" />

                        <TextField fx:id="goalTitleField" promptText="Titel på grønt mål" />

                        <GridPane hgap="10.0" vgap="6.0">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="120.0" />
                                <ColumnConstraints prefWidth="120.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints prefHeight="20.0" />
                                <RowConstraints prefHeight="30.0" />
                            </rowConstraints>

                            <children>
                                <Label styleClass="detail-label" text="Deadline" GridPane.rowIndex="0" />
                                <Label styleClass="detail-label" text="Mål" GridPane.columnIndex="1" />

                                <DatePicker fx:id="deadlineInput" GridPane.rowIndex="1" />

                                <Spinner fx:id="targetInput" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>

                        <TextField fx:id="prizeDescriptionField" promptText="Beskrivelse af grønt mål" />

                        <Button fx:id="addGoalButton" mnemonicParsing="false" onAction="#onAddGoalButtonPressed" styleClass="form-button-primary" text="Indstil grønt mål" />
                    </children>
                </VBox>

            </children>
        </HBox>

        <Region prefHeight="40.0" />

        <!-- TILBAGE-KNAP NEDERST -->
        <HBox alignment="CENTER_RIGHT" prefWidth="600.0">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onBackButtonPressed" styleClass="form-button-secondary" text="Tilbage" />
            </children>
        </HBox>

    </children>
</VBox>
