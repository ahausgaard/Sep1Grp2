<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="400.0" prefWidth="490.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kløverly.presentation.controllers.AdminController">
         <children>
            <Label text="Administratorside">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <GridPane hgap="20.0" prefHeight="350.0" prefWidth="490.0" vgap="20.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints maxHeight="221.00001525878906" minHeight="10.0" prefHeight="221.00001525878906" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="164.0" minHeight="10.0" prefHeight="118.99998474121094" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
                     <children>
                        <Label text="Beboer" />
                        <TextField fx:id="residentNameField" maxWidth="230.0" promptText="Beboers fulde navn" />
                        <Region prefHeight="200.0" prefWidth="200.0" />
                        <Button fx:id="addResidentButton" mnemonicParsing="false" onAction="#onAddResidentButtonPressed" styleClass="button-primary" text="Tilføj beboer" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" GridPane.columnIndex="1">
                     <children>
                        <Label text="Fællesmål" />
                        <TextField fx:id="goalTitleField" promptText="Titel på fællesmål" />
                        <GridPane prefHeight="45.0" prefWidth="225.0">
                          <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints maxHeight="25.00000762939453" minHeight="10.0" prefHeight="16.0" vgrow="SOMETIMES" />
                            <RowConstraints maxHeight="43.999993324279785" minHeight="10.0" prefHeight="29.0" vgrow="SOMETIMES" />
                          </rowConstraints>
                           <children>
                              <Label text="Deadline" />
                              <Label text="Mål" GridPane.columnIndex="1" />
                              <DatePicker fx:id="deadlineInput" GridPane.rowIndex="1" />
                              <Spinner fx:id="targetInput" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                           </children>
                        </GridPane>
                         <TextField fx:id="goalTitleFielddescribtion" promptText="fællesmål beskrivelse" />
                        <Button fx:id="addGoalButton" mnemonicParsing="false" onAction="#onAddGoalButtonPressed" styleClass="button-primary" text="Indstil fællesmål" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
            </GridPane>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="30.0" />
         </padding>
      </VBox>
