<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="490.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Kløverly.presentation.controllers.AddPlanetController">
   <children>
      <Label text="Planet Name:" />
      <TextField fx:id="planetNameInput">
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </TextField>
      <Label text="Climate Description:" />
      <TextField fx:id="climateDescriptionInput">
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </TextField>
      <Label text="Distance from Star (AU):" />
      <TextField fx:id="distanceInput">
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </TextField>
      <CheckBox fx:id="hasAtmosphereCheckbox" mnemonicParsing="false" text="Has Atmosphere">
         <VBox.margin>
            <Insets bottom="5.0" />
         </VBox.margin>
      </CheckBox>
      <CheckBox fx:id="hasLifeCheckBox" mnemonicParsing="false" text="Has Life" />
      <HBox alignment="CENTER" prefHeight="59.0" prefWidth="490.0" spacing="80.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onAddPlanetPressed" text="Add" />
            <Button mnemonicParsing="false" onAction="#onCancelPlanetAddPressed" text="Cancel" />
         </children>
      </HBox>
      <Label fx:id="statusLabel" text="Status:" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
